<Window x:Class="LumaCapture.Windows.ClipExitPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="280" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="Transparent" AllowsTransparency="True" Topmost="True">
    <Border Background="#F2151821" BorderBrush="#3B4254" BorderThickness="1" CornerRadius="18" Padding="28">
        <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><Border Width="50" Height="50" CornerRadius="25" Background="#34293B" HorizontalAlignment="Left"><TextBlock Text="◴" FontSize="24" Foreground="#FF8DA0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="クリップを保存して終了しますか？" FontSize="21" FontWeight="SemiBold" Margin="0,18,0,0"/><TextBlock x:Name="ClipLengthText" Text="保存する長さ" Foreground="#99A2B3" Margin="0,8,0,0"/></StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0"><Button Content="キャンセル" MinWidth="92" Margin="0,0,8,0" Click="Cancel_Click"/><Button Content="保存せず終了" MinWidth="126" Margin="0,0,8,0" Click="Discard_Click"/><Button Content="保存して終了" MinWidth="126" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></StackPanel>
        </Grid>
    </Border>
</Window>
