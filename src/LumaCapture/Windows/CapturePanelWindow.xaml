<Window x:Class="LumaCapture.Windows.CapturePanelWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="700" Height="440" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" Deactivated="Window_Deactivated">
 <Border x:Name="PanelBorder" Background="#F2151821" BorderBrush="#3B4254" BorderThickness="1" CornerRadius="18" Padding="22">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="72"/><RowDefinition Height="40"/></Grid.RowDefinitions>
   <Grid x:Name="DragHandle" Background="Transparent" MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
    <StackPanel Orientation="Horizontal"><Border Width="30" Height="30" CornerRadius="15" Background="#8B6CFF"><TextBlock Text="L" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="LumaCapture" FontWeight="SemiBold" FontSize="17" Margin="10,0" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="⚙" FontFamily="Segoe UI Symbol" FontSize="21" Padding="0" Width="36" Height="34" Click="Settings_Click" ToolTip="設定"/><Button Content="×" Width="36" Height="34" Margin="8,0,0,0" Padding="0" Click="Hide_Click" ToolTip="閉じる"/></StackPanel>
   </Grid>
   <Grid Grid.Row="1" Margin="0,14,0,14">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
    <Border Background="#151821" BorderBrush="#343A49" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,14,0">
     <StackPanel>
      <TextBlock Text="録画する画面" Foreground="#99A2B3" FontSize="12"/>
      <TextBlock x:Name="TargetText" Text="メイン画面" FontSize="19" FontWeight="SemiBold" Margin="0,7,0,10" TextTrimming="CharacterEllipsis"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
       <ComboBox x:Name="TargetCombo" SelectionChanged="TargetCombo_SelectionChanged"/>
       <Button Grid.Column="1" x:Name="AppPickerButton" Margin="8,0,0,0" Padding="8,6" Click="AppPicker_Click" ToolTip="録画対象のアプリを選択"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Margin="0,0,6,0"/><TextBlock Text="アプリ"/></StackPanel></Button>
      </Grid>
      <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="画質" FontSize="11" Foreground="#99A2B3" Margin="0,0,0,6"/><ComboBox x:Name="QualityCombo" SelectionChanged="QualityCombo_SelectionChanged"><ComboBoxItem Content="高画質  60 FPS" Tag="High"/><ComboBoxItem Content="標準  30 FPS" Tag="Standard"/><ComboBoxItem Content="軽量  30 FPS" Tag="Compact"/></ComboBox></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="録画解像度" FontSize="11" Foreground="#99A2B3" Margin="0,0,0,6"/><ComboBox x:Name="ResolutionCombo" SelectionChanged="ResolutionCombo_SelectionChanged"><ComboBoxItem Content="1080p" Tag="P1080"/><ComboBoxItem Content="720p" Tag="P720"/><ComboBoxItem Content="1440p" Tag="P1440"/><ComboBoxItem Content="2160p" Tag="P2160"/><ComboBoxItem Content="元の解像度" Tag="Original"/></ComboBox></StackPanel>
      </Grid>
     </StackPanel>
    </Border>
    <Border Grid.Column="1" Background="#151821" BorderBrush="#343A49" BorderThickness="1" CornerRadius="12" Padding="10">
     <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="StatusText" Text="録画を開始" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
      <Button x:Name="RecordButton" Background="Transparent" BorderBrush="Transparent" Padding="0" Click="Record_Click" ToolTip="録画を開始 / 停止" Margin="0,14">
       <Grid Width="72" Height="72"><Ellipse Fill="#2A2029" Stroke="#70404A" StrokeThickness="1"/><Ellipse x:Name="RecordDot" Width="25" Height="25" Fill="#FF526D"/><Border x:Name="StopSquare" Width="21" Height="21" CornerRadius="4" Background="#FF526D" Visibility="Collapsed"/></Grid>
      </Button>
      <TextBlock x:Name="HintText" Text="クリックで開始" Foreground="#99A2B3" FontSize="12" HorizontalAlignment="Center"/>
     </StackPanel>
    </Border>
   </Grid>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button Background="#151821" BorderBrush="#343A49" Padding="12,8" Click="Audio_Click" HorizontalContentAlignment="Stretch" ToolTip="音声">
     <StackPanel><TextBlock Text="音声" FontSize="11" Foreground="#99A2B3"/><TextBlock x:Name="AudioSummary" Text="PC内の音をすべて録音" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="MicSummary" Text="マイク: OFF" FontSize="11" Foreground="#99A2B3" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
    </Button>
    <Button Grid.Column="2" x:Name="ClipButton" Click="Clip_Click" Padding="12,8" HorizontalContentAlignment="Stretch"><StackPanel><TextBlock Text="直前クリップを保存" FontWeight="SemiBold"/><TextBlock x:Name="ClipSummary" Foreground="#99A2B3" FontSize="11" Margin="0,6,0,0"/></StackPanel></Button>
   </Grid>
   <Button Grid.Row="3" Click="Folder_Click" Background="Transparent" BorderBrush="Transparent" Padding="0" HorizontalContentAlignment="Left" Margin="0,10,0,0"><TextBlock x:Name="FolderText" Foreground="#99A2B3" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="640"/></Button>
  </Grid>
 </Border>
</Window>
