<Window x:Class="LumaCapture.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1040" Height="740" MinWidth="960" MinHeight="640" WindowStyle="None" AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Border Background="#FB0D0F14" BorderBrush="#3B4254" BorderThickness="1" CornerRadius="18">
        <Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0"><Border Width="30" Height="30" CornerRadius="15" Background="#8B6CFF"><TextBlock Text="L" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="LumaCapture 設定" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="11,0,0,0"/></StackPanel><Button Grid.Column="1" Content="×" FontSize="19" Padding="0" Margin="9" Click="Cancel_Click"/></Grid>
            <TabControl x:Name="SettingsTabs" Grid.Row="1" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" Margin="18,10,18,0">
                <TabControl.ItemContainerStyle><Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Setter Property="MinWidth" Value="148"/><Setter Property="Height" Value="46"/><Setter Property="Margin" Value="0,0,16,6"/></Style></TabControl.ItemContainerStyle>
                <TabItem Header="保存・録画"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8,24,8,18">
                    <TextBlock Text="動画の保存先" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="通常録画・クリップ・分離音声をこのフォルダーへ保存します。" Foreground="#99A2B3" Margin="0,6,0,10"/>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBox x:Name="OutputDirectoryBox"/><Button Grid.Column="1" Content="選択" Margin="8,0,0,0" Padding="8" Click="BrowseFolder_Click"/><Button Grid.Column="2" Content="開く" Margin="8,0,0,0" Padding="8" Click="OpenFolder_Click"/></Grid>
                    <TextBlock Text="録画" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0"/>
                    <Border Background="#151821" BorderBrush="#303646" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,12,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="58"/><RowDefinition Height="58"/><RowDefinition Height="45"/><RowDefinition Height="45"/><RowDefinition Height="45"/></Grid.RowDefinitions><TextBlock Text="録画する画面" VerticalAlignment="Center"/><ComboBox x:Name="CaptureAreaCombo" Grid.Column="1" Margin="10,8"/><TextBlock Grid.Row="1" Text="録画解像度" VerticalAlignment="Center"/><ComboBox x:Name="ResolutionCombo" Grid.Row="1" Grid.Column="1" Margin="10,8"><ComboBoxItem Content="元の解像度" Tag="Original"/><ComboBoxItem Content="2160p（4K相当）" Tag="P2160"/><ComboBoxItem Content="1440p" Tag="P1440"/><ComboBoxItem Content="1080p（デフォルト）" Tag="P1080"/><ComboBoxItem Content="720p" Tag="P720"/></ComboBox><TextBlock Grid.Row="2" Text="デフォルト画質" VerticalAlignment="Center"/><ComboBox x:Name="QualityCombo" Grid.Row="2" Grid.Column="1" Margin="10,8"><ComboBoxItem Content="高画質（60 FPS）" Tag="High"/><ComboBoxItem Content="標準（30 FPS）" Tag="Standard"/><ComboBoxItem Content="軽量（30 FPS）" Tag="Compact"/></ComboBox><CheckBox x:Name="CursorCheck" Grid.Row="3" Grid.ColumnSpan="2" Content="マウスカーソルも録画する"/><CheckBox x:Name="RecIndicatorCheck" Grid.Row="4" Grid.ColumnSpan="2" Content="録画中、左上に ● REC を表示する（動画には映りません）"/><CheckBox x:Name="AlwaysShowPanelCheck" Grid.Row="5" Grid.ColumnSpan="2" Content="録画ボタンを常に表示する"/></Grid></Border>
                    <TextBlock Text="常駐" FontSize="18" FontWeight="SemiBold"/><Border Background="#151821" BorderBrush="#303646" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,12,0,20"><CheckBox x:Name="StartupCheck" Content="Windowsへのサインイン時に自動起動する"/></Border>
                    <TextBlock Text="容量保護" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="空き容量が少なくなったら通知し、危険な水準では録画を自動停止します。" Foreground="#99A2B3" Margin="0,6,0,10"/>
                    <Border Background="#151821" BorderBrush="#303646" BorderThickness="1" CornerRadius="12" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="54"/></Grid.RowDefinitions><TextBlock Text="通知する空き容量" VerticalAlignment="Center"/><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><TextBox x:Name="WarningGbBox"/><TextBlock Grid.Column="1" Text="GB" VerticalAlignment="Center" Margin="7,0,0,0" Foreground="#99A2B3"/></Grid><TextBlock Grid.Row="1" Text="自動停止する空き容量" VerticalAlignment="Center"/><Grid Grid.Row="1" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><TextBox x:Name="AutoStopGbBox"/><TextBlock Grid.Column="1" Text="GB" VerticalAlignment="Center" Margin="7,0,0,0" Foreground="#99A2B3"/></Grid></Grid></Border>
                </StackPanel></ScrollViewer></TabItem>

                <TabItem Header="音声"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8,24,8,18">
                    <TextBlock Text="録音する音" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="PC全体の音、または選んだアプリだけの音を録音できます。" Foreground="#99A2B3" Margin="0,6,0,10"/>
                    <ComboBox x:Name="AudioModeCombo" SelectionChanged="AudioModeCombo_SelectionChanged"><ComboBoxItem Content="PC内の音をすべて録音" Tag="SystemAudio"/><ComboBoxItem Content="選択したアプリだけ録音" Tag="SelectedApplications"/></ComboBox>
                    <TextBlock Text="アプリ未選択でも保存できます。その場合、PC・アプリ音声は収録せず、選択済みのマイクのみ収録します。" TextWrapping="Wrap" Foreground="#99A2B3" FontSize="12" Margin="0,8,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedItem.Tag, ElementName=AudioModeCombo}" Value="SelectedApplications"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    <TextBlock Text="マイク" FontSize="18" FontWeight="SemiBold" Margin="0,22,0,0"/><TextBlock Text="使用する入力デバイスを選択します。マイク音声は自動的に中央から聞こえるよう補正します。" Foreground="#99A2B3" Margin="0,6,0,10"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions><ComboBox x:Name="MicrophoneCombo" SelectionChanged="MicrophoneCombo_SelectionChanged"/><Button Grid.Column="1" Content="一覧を更新" Margin="8,0,0,0" Padding="10,7" Click="RefreshMicrophones_Click"/></Grid>
                    <Border Background="#151821" BorderBrush="#303646" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions><TextBlock Text="収録する音の反応" FontWeight="SemiBold"/><TextBlock x:Name="AudioLevelText" Grid.Column="1" Text="待機中" HorizontalAlignment="Right" Foreground="#99A2B3" FontSize="12"/></Grid>
                            <ProgressBar x:Name="AudioLevelBar" Style="{StaticResource AudioLevelBar}" Foreground="#8B6CFF"/>
                            <Grid Margin="0,14,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions><TextBlock Text="マイクの反応" FontWeight="SemiBold"/><TextBlock x:Name="MicrophoneLevelText" Grid.Column="1" Text="OFF" HorizontalAlignment="Right" Foreground="#99A2B3" FontSize="12"/></Grid>
                            <ProgressBar x:Name="MicrophoneLevelBar" Style="{StaticResource AudioLevelBar}" Foreground="#4DD8C2"/>
                            <TextBlock Text="設定画面を開いている間だけ軽量メーターで確認します。" Foreground="#7F899A" FontSize="11" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="動画と音声の保存方法" FontSize="18" FontWeight="SemiBold" Margin="0,22,0,0"/><TextBlock Text="通常はMP4に音声を入れます。必要なときだけWAVへ分離できます。" Foreground="#99A2B3" Margin="0,6,0,10"/>
                    <ComboBox x:Name="AudioOutputCombo"><ComboBoxItem Content="動画に音声を入れる（デフォルト）" Tag="EmbedInVideo"/><ComboBoxItem Content="動画 + まとめた音声.wav" Tag="SplitMixed"/><ComboBoxItem Content="動画 + アプリごとの音声.wav" Tag="SplitPerApplication"/></ComboBox>
                    <StackPanel x:Name="ApplicationsPanel" Margin="0,22,0,0"><Grid><TextBlock Text="録音するアプリ（複数選択可）" FontSize="18" FontWeight="SemiBold"/><Button Content="一覧を更新" HorizontalAlignment="Right" Padding="11,6" Click="RefreshProcesses_Click"/></Grid><TextBlock Text="ゲームやDiscordを起動してから更新してください。選択はアプリ名で記憶されます。" Foreground="#99A2B3" Margin="0,6,0,10"/><Border Background="#151821" BorderBrush="#303646" BorderThickness="1" CornerRadius="12" Padding="14" Height="270"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ProcessList"/></ScrollViewer></Border><TextBlock Text="※ アプリ単位録音は Windows build 20348 以降で利用できます（Windows 11 推奨）。" Foreground="#7F899A" Margin="2,10,0,0"/></StackPanel>
                </StackPanel></ScrollViewer></TabItem>

                <TabItem Header="クリップ"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8,24,8,18">
                    <TextBlock Text="直前の映像を保存" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="常駐中に映像を一時保持し、Alt + C で決定的な瞬間をさかのぼって保存します。" Foreground="#99A2B3" Margin="0,6,0,14" TextWrapping="Wrap"/>
                    <Border Background="#151821" BorderBrush="#303646" BorderThickness="1" CornerRadius="12" Padding="18"><StackPanel>
                        <CheckBox x:Name="ClipEnabledCheck" Content="クリップ機能を有効にする" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ConfirmClipOnExitCheck" Content="終了時に保存するか確認する" Margin="0,0,0,20"/>
                        <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="クリップするモニター" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="クリップは選択した画面全体を常に録画します。" Foreground="#99A2B3" FontSize="11" Margin="0,4,12,0"/></StackPanel><ComboBox x:Name="ClipDisplayCombo" Grid.Column="1"/></Grid>
                        <StackPanel Margin="0,0,0,20"><TextBlock Text="一時データの保存先" FontWeight="SemiBold" FontSize="15"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBox x:Name="ClipCacheDirectoryBox"/><Button Grid.Column="1" Content="選択" Margin="8,0,0,0" Padding="8" Click="BrowseClipCacheFolder_Click"/><Button Grid.Column="2" Content="開く" Margin="8,0,0,0" Padding="8" Click="OpenClipCacheFolder_Click"/></Grid><TextBlock Text="LumaCaptureの一時ファイルだけを使用し、通常終了時と次回起動時に削除します。" Foreground="#99A2B3" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions><TextBlock Text="保存する長さ" FontWeight="SemiBold" FontSize="15"/><Border Grid.Column="1" Background="#202431" BorderBrush="#3B4254" BorderThickness="1" CornerRadius="9" Height="38"><TextBlock x:Name="ClipValueText" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#DCCFFF"/></Border></Grid>
                        <Grid Height="40" Margin="0,18,0,0">
                            <Slider x:Name="ClipSecondsSlider" Minimum="0" Maximum="4" TickFrequency="1" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" ValueChanged="ClipSlider_ValueChanged"/>
                            <Grid Margin="10,0" IsHitTestVisible="False"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="#C9BFFF"/>
                                <Ellipse Grid.Column="0" Grid.ColumnSpan="2" Width="7" Height="7" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#C9BFFF"/>
                                <Ellipse Grid.Column="1" Grid.ColumnSpan="2" Width="7" Height="7" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#C9BFFF"/>
                                <Ellipse Grid.Column="2" Grid.ColumnSpan="2" Width="7" Height="7" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#C9BFFF"/>
                                <Ellipse Grid.Column="3" Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="#C9BFFF"/>
                            </Grid>
                        </Grid>
                        <Grid Margin="10,3,10,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="30秒" HorizontalAlignment="Left" Foreground="#99A2B3" FontSize="12"/>
                            <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Text="60秒" HorizontalAlignment="Center" Foreground="#99A2B3" FontSize="12"/>
                            <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="120秒" HorizontalAlignment="Center" Foreground="#99A2B3" FontSize="12"/>
                            <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Text="300秒" HorizontalAlignment="Center" Foreground="#99A2B3" FontSize="12"/>
                            <TextBlock Grid.Column="3" Text="600秒" HorizontalAlignment="Right" Foreground="#99A2B3" FontSize="12"/>
                        </Grid>
                    </StackPanel></Border>
                    <Border Background="#242031" BorderBrush="#5B4B83" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,16,0,0"><TextBlock Foreground="#D7CAFF" TextWrapping="Wrap" LineHeight="20">クリップ用の一時データは設定秒数を超えると自動削除されます。通常終了時に削除し、予期せぬ終了やPC再起動で残った場合も次回起動時に回収します。</TextBlock></Border>
                </StackPanel></ScrollViewer></TabItem>

                <TabItem Header="ホットキー"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8,24,8,18">
                    <TextBlock Text="グローバルホットキー" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="入力欄をクリックして、使いたいキーの組み合わせを押してください。" Foreground="#99A2B3" Margin="0,6,0,14"/>
                    <Border Background="#151821" BorderBrush="#303646" BorderThickness="1" CornerRadius="12" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="64"/></Grid.RowDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="録画UIを表示" FontWeight="SemiBold"/><TextBlock Text="デフォルト: Win + Shift + C" Foreground="#7F899A" FontSize="11" Margin="0,3,0,0"/></StackPanel><TextBox x:Name="CaptureHotkeyBox" Grid.Column="1" IsReadOnly="True" Tag="Capture" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/><StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="直前クリップを保存" FontWeight="SemiBold"/><TextBlock Text="デフォルト: Alt + C" Foreground="#7F899A" FontSize="11" Margin="0,3,0,0"/></StackPanel><TextBox x:Name="ClipHotkeyBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Tag="Clip" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/></Grid></Border><Button Content="デフォルトに戻す" HorizontalAlignment="Left" Margin="0,14,0,0" Click="ResetHotkeys_Click"/>
                </StackPanel></ScrollViewer></TabItem>

                <TabItem Header="情報"><StackPanel Margin="18,32"><Border Width="66" Height="66" CornerRadius="33" Background="#8B6CFF" HorizontalAlignment="Left"><TextBlock Text="L" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="LumaCapture" FontSize="25" FontWeight="SemiBold" Margin="0,16,0,0"/><TextBlock Text="Version 0.12.1  •  Windows x64" Foreground="#99A2B3" Margin="0,5,0,18"/><TextBlock Text="言語" FontWeight="SemiBold" Margin="0,0,0,7"/><ComboBox x:Name="LanguageCombo" Width="260" HorizontalAlignment="Left" SelectionChanged="LanguageCombo_SelectionChanged"><ComboBoxItem Content="日本語" Tag="Japanese"/><ComboBoxItem Content="English" Tag="English"/><ComboBoxItem Content="한국어" Tag="Korean"/><ComboBoxItem Content="简体中文" Tag="ChineseSimplified"/><ComboBoxItem Content="繁體中文" Tag="ChineseTraditional"/></ComboBox><TextBlock Text="LumaScreenshot と同じ操作感で、画面録画・アプリ別音声・直前クリップ・容量保護をローカルで行う常駐アプリです。" TextWrapping="Wrap" MaxWidth="610" HorizontalAlignment="Left" LineHeight="22" Margin="0,18,0,0"/><Button Content="Captura の参考ソースを開く" HorizontalAlignment="Left" Margin="0,18,0,0" Click="OpenCaptura_Click"/></StackPanel></TabItem>
            </TabControl>
            <Grid Grid.Row="2" Margin="26,12,26,18"><TextBlock x:Name="ValidationText" Foreground="#FF8DA0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="500" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="キャンセル" MinWidth="100" Margin="0,0,10,0" Click="Cancel_Click"/><Button Content="保存" MinWidth="110" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></StackPanel></Grid>
        </Grid>
    </Border>
</Window>
