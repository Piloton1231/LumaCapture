<Window x:Class="LumaCapture.Windows.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="370" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False" Topmost="True" Background="Transparent" Deactivated="Window_Deactivated">
    <Border Background="#F2151821" BorderBrush="#3B4254" BorderThickness="1" CornerRadius="16" Padding="10">
        <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.48" Color="Black"/></Border.Effect>
        <StackPanel>
            <Grid Margin="10,8,10,12"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="17" Background="#8B6CFF"><TextBlock Text="L" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="LumaCapture" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Text="録画とクリップをすぐに。" FontSize="11" Foreground="#99A2B3" Margin="0,2,0,0"/></StackPanel></Grid>
            <Button HorizontalContentAlignment="Stretch" Click="ShowPanel_Click" Margin="0,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="録画UIを表示"/><TextBlock Grid.Column="1" Text="Win + Shift + C" Foreground="#99A2B3"/></Grid></Button>
            <Button x:Name="RecordButton" Content="録画を開始" HorizontalContentAlignment="Left" Click="Record_Click" Margin="0,2"/>
            <Button HorizontalContentAlignment="Stretch" Click="Clip_Click" Margin="0,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ClipText" Text="直前60秒を保存"/><TextBlock Grid.Column="1" Text="Alt + C" Foreground="#99A2B3"/></Grid></Button>
            <Rectangle Height="1" Fill="#343A49" Margin="8,9"/><Button Content="保存フォルダーを開く" HorizontalContentAlignment="Left" Click="OpenFolder_Click" Margin="0,2"/><Button Content="設定" HorizontalContentAlignment="Left" Click="Settings_Click" Margin="0,2"/>
            <Rectangle Height="1" Fill="#343A49" Margin="8,9"/><Button Content="終了" HorizontalContentAlignment="Left" Click="Exit_Click" Margin="0,2" Foreground="#FF8DA0"/>
        </StackPanel>
    </Border>
</Window>
