<Window x:Class="LumaCapture.Windows.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="680" Height="560" WindowStyle="None" AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <Border Background="#FC0D0F14" BorderBrush="#3B4254" BorderThickness="1" CornerRadius="18">
        <Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="78"/></Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions><TextBlock x:Name="WindowTitle" Text="LumaCapture セットアップ" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="22,0"/><Button x:Name="CloseButton" Grid.Column="1" Content="×" FontSize="19" Padding="0" Margin="9" Click="Close_Click"/></Grid>
            <StackPanel Grid.Row="1" Margin="42,20,42,0"><Border Width="72" Height="72" CornerRadius="36" Background="#8B6CFF" HorizontalAlignment="Left"><TextBlock x:Name="LogoGlyph" Text="L" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="HeadingText" Text="LumaCapture をインストール" FontSize="25" FontWeight="SemiBold" Margin="0,22,0,0"/><TextBlock x:Name="DescriptionText" Text="録画と直前クリップを、いつでもすぐに。" TextWrapping="Wrap" Foreground="#AAB2C2" FontSize="14" Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><TextBlock Text="言語" VerticalAlignment="Center" Margin="0,0,14,0"/><ComboBox x:Name="LanguageCombo" Width="250" SelectionChanged="Language_Changed"><ComboBoxItem Content="日本語" Tag="Japanese"/><ComboBoxItem Content="English" Tag="English"/><ComboBoxItem Content="한국어" Tag="Korean"/><ComboBoxItem Content="简体中文" Tag="ChineseSimplified"/><ComboBoxItem Content="繁體中文" Tag="ChineseTraditional"/></ComboBox></StackPanel>
                <StackPanel x:Name="OptionsPanel" Margin="0,21,0,0"><CheckBox x:Name="StartupCheck" Content="Windowsへのサインイン時に自動起動" IsChecked="True" Margin="0,3,0,12"/><CheckBox x:Name="DesktopCheck" Content="デスクトップにショートカットを作成" IsChecked="True"/></StackPanel>
                <Border x:Name="ProgressTrack" Height="7" Background="#202431" CornerRadius="4" Margin="0,22,0,0" Visibility="Collapsed"><Grid HorizontalAlignment="Left"><Border x:Name="ProgressFill" Width="0" Background="#8B6CFF" CornerRadius="4"/></Grid></Border><TextBlock x:Name="StatusText" Foreground="#99A2B3" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,42,22"><Button x:Name="SecondaryButton" Content="キャンセル" MinWidth="105" Margin="0,0,10,0" Click="Close_Click"/><Button x:Name="PrimaryButton" Content="インストール" MinWidth="116" Style="{StaticResource PrimaryButton}" Click="Primary_Click"/></StackPanel>
        </Grid>
    </Border>
</Window>
