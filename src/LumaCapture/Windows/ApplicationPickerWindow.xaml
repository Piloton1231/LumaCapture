<Window x:Class="LumaCapture.Windows.ApplicationPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" Height="620" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#0D0F14" AllowsTransparency="True">
    <Border Background="#F20D0F14" BorderBrush="#3B4254" BorderThickness="1" CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions><TextBlock Text="録画対象のアプリを選択" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="22,0"/><Button Grid.Column="1" Content="×" FontSize="19" Padding="0" Margin="9" Click="Cancel_Click"/></Grid>
            <StackPanel Grid.Row="1" Margin="24,12,24,0"><TextBlock Text="表示中のアプリから録画対象を選びます。" Foreground="#99A2B3" Margin="0,0,0,16"/><TextBlock Text="アプリ名で検索" Foreground="#99A2B3" FontSize="11" Margin="0,0,0,6"/><TextBox x:Name="SearchBox" TextChanged="Search_Changed" Margin="0,0,0,12"/><Border Background="#151821" BorderBrush="#303646" BorderThickness="1" CornerRadius="12" Padding="10" Height="350"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ProcessPanel"/></ScrollViewer></Border></StackPanel>
            <Grid Grid.Row="2" Margin="24,12,24,18">
                <Button Content="一覧を更新" HorizontalAlignment="Left" Click="Refresh_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ClearSelectionButton" Content="選択解除" MinWidth="100" Margin="0,0,8,0" Click="ClearSelection_Click"/>
                    <Button Content="キャンセル" MinWidth="100" Click="Cancel_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
