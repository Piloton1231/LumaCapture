<Window x:Class="LumaCapture.Windows.RecIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="142" Height="42" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True" ShowActivated="False">
    <Border Background="#E90D0F14" BorderBrush="#5B3440" BorderThickness="1" CornerRadius="11" Padding="11,7">
        <StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="#FF526D" VerticalAlignment="Center"/><TextBlock Text="REC" Foreground="#FF7188" FontWeight="Bold" FontSize="12" Margin="8,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="TimeText" Text="00:00" Foreground="White" FontSize="12" VerticalAlignment="Center"/></StackPanel>
    </Border>
</Window>
